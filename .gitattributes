# Как git обращается с переводами строк.
#
# Правила здесь появились не из общих соображений — каждое закрывает поломку,
# которая уже случалась:
#
#   * монитор молча переставал запускаться: с core.autocrlf=true на Windows
#     файл получал CRLF, и после scp на сервер ломался shebang —
#     /usr/bin/env: 'python3\r': No such file or directory;
#   * сборка образа падала на проверке контрольной суммы: правило
#     «*.pem text eol=lf» переписывало сертификат УЦ в LF, и sha256 переставала
#     совпадать с закреплённой. На Windows рабочая копия выглядела правильной.
#
# Отсюда деление: слева файлы, которые ИСПОЛНЯЮТСЯ на Linux и обязаны быть в
# LF; справа — те, где важны БАЙТЫ, и git не должен трогать их вовсе.

# ─── Исполняются или читаются на Linux-сервере: строго LF ────────────────────

monitoring/*.py            text eol=lf
monitoring/*.service       text eol=lf
monitoring/*.timer         text eol=lf
monitoring/*.env.example   text eol=lf

# У всех скриптов здесь есть shebang, и любой может быть запущен напрямую.
scripts/*.py               text eol=lf
scripts/*.sh               text eol=lf

# CRLF в Dockerfile превращается в \r на конце shell-команды внутри RUN:
# ломаются продолжения строк и всё, что разбирает вывод.
Dockerfile                 text eol=lf

# Конфиги nginx уезжают в образ фронтенда и на хост.
*.conf                     text eol=lf

# Читается pip внутри Linux-контейнера.
requirements.txt           text eol=lf

# ─── Важны байты: git не трогает ─────────────────────────────────────────────

# Сертификаты УЦ Минцифры. Их целостность проверяется по sha256, закреплённой
# в backend/build_ca_bundle.py, а с gu-st.ru они приходят с CRLF внутри.
# Любая нормализация ломает сумму и останавливает сборку образа.
*.pem                      binary
*.cer                      binary
*.crt                      binary
*.key                      binary

# Изображения и PDF. Обычно git распознаёт бинарники сам, по NUL-байтам, но
# на это НЕЛЬЗЯ полагаться: frontend/public/qr-cabinet.pdf не содержит ни
# одного NUL в первых 8000 байтах, поэтому git считает его ТЕКСТОМ — и внутри
# у него 76 символов CR. Пока файл цел (69200 байт и в репозитории, и на
# диске), но одна перегенерация или другая настройка autocrlf — и PDF
# испортится без единого сообщения.
*.pdf                      binary
*.png                      binary
*.jpg                      binary
*.jpeg                     binary
*.gif                      binary
*.webp                     binary
*.ico                      binary
*.avif                     binary

# Шрифты и архивы — на будущее: в репозитории их сейчас нет, но появятся
# однажды, и разбираться с испорченным .woff2 не хочется.
*.woff                     binary
*.woff2                    binary
*.ttf                      binary
*.otf                      binary
*.eot                      binary
*.zip                      binary
*.gz                       binary
*.xlsx                     binary
*.docx                     binary

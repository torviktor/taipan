.env
# Бэкапы .env с боевыми секретами (делаются на сервере при правке).
# Голый шаблон `.env` их НЕ покрывает — без этой строки они видны git add -A.
.env.bak-*
.env.*.bak

# Дампы БД: персональные данные родителей и детей. Публиковать нельзя.
backups/
*.sql
!backend/migrations/**/*.sql

# QR-poster fonts (downloaded locally; SIL OFL but binary, no need in repo)
scripts/fonts/

# Personal Claude Code permissions — local-only, do not commit
.claude/settings.local.json
node_modules
__pycache__/
*.py[cod]

# Рабочий план проекта — живёт только локально, в публичный репозиторий не коммитить
taipan_plan.md

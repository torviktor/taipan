# Копия должна лежать на сервере в /etc/taipan-monitor.env с правами 600.
# В git этот файл НЕ попадает — там боевой токен бота.
#
#   install -m 600 /dev/null /etc/taipan-monitor.env
#   и заполнить значения ниже

# Тот же бот, что и у сайта: значение берётся из /opt/taipan/.env
TELEGRAM_BOT_TOKEN=

# Базовый адрес Bot API. Прямой канал до api.telegram.org с этого сервера
# теряет около половины запросов, поэтому на проде здесь стоит адрес
# Cloudflare Worker, прозрачно пробрасывающего /bot<token>/<method>.
# Пусто — значит https://api.telegram.org напрямую.
TELEGRAM_API_BASE=

# Секрет воркера-релея, уходит заголовком x-bridge-auth. Без него строгая
# версия воркера отвечает 403. Пусто — заголовок не отправляется (нужно при
# обращении напрямую к api.telegram.org).
TELEGRAM_API_SECRET=

# Куда слать алерты. Это личный chat_id админа, НЕ канал клуба:
# падение сайта — не новость для родителей.
#
# Как узнать: админ пишет боту @taipan_tkd_bot команду
#     /link <свой телефон>
# после чего на сервере:
#     /opt/taipan-monitor/taipan_monitor.py --resolve-chat
ALERT_CHAT_ID=

# Копия должна лежать на сервере в /etc/taipan-monitor.env с правами 600.
# В git этот файл НЕ попадает — там боевой токен бота.
#
#   install -m 600 /dev/null /etc/taipan-monitor.env
#   и заполнить значения ниже

# Тот же бот, что и у сайта: значение берётся из /opt/taipan/.env
TELEGRAM_BOT_TOKEN=

# Куда слать алерты. Это личный chat_id админа, НЕ канал клуба:
# падение сайта — не новость для родителей.
#
# Как узнать: админ пишет боту @taipan_tkd_bot команду
#     /link <свой телефон>
# после чего на сервере:
#     /opt/taipan-monitor/taipan_monitor.py --resolve-chat
ALERT_CHAT_ID=

[Unit]
Description=Ежедневная сводка мониторинга Тайпан в 09:00 МСК

[Timer]
# Сервер живёт в UTC, 06:00 UTC = 09:00 МСК. Начало рабочего дня выбрано
# намеренно: отсутствие сводки замечается сразу, а не вечером.
OnCalendar=*-*-* 06:00:00 UTC
# Разброс до минуты, чтобы не бить ровно в секунду вместе с остальным.
RandomizedDelaySec=60
# Если сервер был выключен в 06:00 — отправить сразу после включения.
Persistent=true
Unit=taipan-monitor-heartbeat.service

[Install]
WantedBy=timers.target

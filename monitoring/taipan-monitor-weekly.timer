[Unit]
Description=Недельная глубокая проверка Тайпан: разворот бэкапа и корни Минцифры

[Timer]
# Понедельник 06:30 UTC = 09:30 МСК, через полчаса после ежедневной сводки.
# Разнесены намеренно: два сообщения подряд сливаются в одно уведомление и
# читаются как одно, а недельная проверка должна попадаться на глаза отдельно.
OnCalendar=Mon *-*-* 06:30:00 UTC
# Разброс до минуты, чтобы не бить ровно в секунду вместе с остальным.
RandomizedDelaySec=60
# Если сервер был выключен в понедельник утром — выполнить после включения.
Persistent=true
Unit=taipan-monitor-weekly.service

[Install]
WantedBy=timers.target
